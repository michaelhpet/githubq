# Client ID of the GitHub OAuth App (public — safe to expose in the bundle).
# Create one at https://github.com/settings/developers (OAuth Apps → New).
# Set its Authorization callback URL to {your-origin}/callback.
# Use a second OAuth App for http://localhost:5173/callback in local dev.
# Copy this file to .env and fill in your own values (never commit .env).
VITE_GITHUB_CLIENT_ID=

# Server-side only (Vercel → Project Settings → Environment Variables,
# and .env / `vercel env pull` for local `vercel dev`).
# Never prefix these with VITE_ — they must not ship to the browser.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
